# Copy this file to .env and fill in the values, then run: node server.js

# Port for this site. Optional.
PORT=3000

# API key from https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that receives contact form messages.
MAIL_TO=you@example.com

# Sender address. Verify this domain in Resend before real mail will deliver.
# For a first test, onboarding@resend.dev can send only to the email on your Resend account.
MAIL_FROM=hello@yourdomain.com

# Name shown on the message. Optional.
MAIL_FROM_NAME=BearMail

# Set to 1 when a reverse proxy in front of this server sets X-Forwarded-For.
# TRUST_PROXY=1
